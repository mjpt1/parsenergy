DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated; only used when DEBUG=0 (production)
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# DB: leave unset for local SQLite. In production (Docker) set a Postgres URL:
# DATABASE_URL=postgres://solarops:solarops@db:5432/solarops
# Cache/Channels use Redis only when these are enabled (production/Docker):
# USE_REDIS_CACHE=1
# USE_REDIS_CHANNELS=1
# REDIS_URL=redis://127.0.0.1:6379/0
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@solarops.local
SMS_PROVIDER=mock
PUSH_PROVIDER=webpush
