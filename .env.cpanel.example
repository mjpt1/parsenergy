# Copy this to ".env" in the application root on cPanel and edit the values.
# Generate a SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=PUT-A-LONG-RANDOM-VALUE-HERE
DEBUG=False

# Your domain(s) — comma separated, no scheme.
ALLOWED_HOSTS=example.com,www.example.com

# Same domain(s) WITH https:// — needed for form/CSRF submission.
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Serve uploaded files (logos, contract .docx) through Django (no extra web
# server config needed on cPanel).
SERVE_MEDIA=True

# HTTPS: keep True once AutoSSL is active. If you get redirect loops before the
# certificate is issued, temporarily set this to False.
SECURE_SSL_REDIRECT=True

# --- Database -----------------------------------------------------------------
# Leave DATABASE_URL unset to use SQLite (db.sqlite3 in the app root) — simplest.
# For the cPanel MySQL database (create it in "MySQL Databases" first):
# DATABASE_URL=mysql://cpaneluser_dbuser:THEPASSWORD@localhost/cpaneluser_dbname

# --- Optional: keep these only if you actually run Redis/Celery (usually not) --
# USE_REDIS_CACHE=False
# USE_REDIS_CHANNELS=False

# SMS gateway and Shahkar identity service are configured in the admin UI
# ("🔌 تنظیمات سرویس‌ها"), not here.
